# Copy to `.env` and fill in your own values. `.env` is gitignored — never commit
# real keys. Load it however you like (e.g. `set -a; . ./.env; set +a`,
# python-dotenv, or your process manager).

# Your Inference Wallet Key — the root credential. `vorq.Client()` reads this,
# signs the session handshake locally, and mints + rotates the session token
# under the hood. Use a DEDICATED wallet funded with your inference budget —
# never a main wallet's key.
VORQ_WALLET_KEY=0x<your secp256k1 wallet private key>

# Optional — Curve25519 private key (hex) for end-to-end sealed-box encryption.
# Used only by a client without a wallet signer; a wallet derives its own result
# key, and an explicit `cipher=` always wins.
VORQ_CIPHER_KEY=<your curve25519 private key hex>
