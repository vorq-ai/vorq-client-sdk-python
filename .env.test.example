# Copy to `.env.test` and fill with THROWAWAY key material only — never a wallet
# that holds real funds. `.env.test` is gitignored; this example is committed.
# Only private keys go here; addresses and public keys are derived from them.
#
# Generate a fresh set with:
#     python scripts/gen_test_keys.py
# and paste the output below.

# Ethereum signing wallet (EIP-712 order + session signatures)
VORQ_WALLET_KEY=0x<64-hex secp256k1 private key>

# Curve25519 sealed-box key (our own identity — used to decrypt / expose public key)
VORQ_CIPHER_KEY=<64-hex curve25519 private key>

# A second Curve25519 key standing in for a counterparty (encrypt-to target)
VORQ_RECIPIENT_KEY=<64-hex curve25519 private key>
